generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WhitelistStatus {
  PENDING_REGISTRATION
  REGISTERED
  REVOKED
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY_FOR_REVIEW
  REVISION_REQUIRED
  RESUBMITTED
  APPROVED
}

enum AdviserLinkStatus {
  PENDING
  ACTIVE
  DECLINED
  EXPIRED
  REMOVED
  CANCELLED
}

enum AdviserInitiator {
  STUDENT
  ADVISER
  ADMIN
}

model Tenant {
  id              String             @id @default(uuid())
  institutionName String
  emailDomain     String             @unique
  isActive        Boolean            @default(true)
  users           User[]
  projects        Project[]
  whitelists      FacultyWhitelist[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                  String            @id @default(uuid())
  cognitoId           String            @unique
  email               String            @unique
  firstName           String?
  lastName            String?
  avatarUrl           String?
  isActive            Boolean           @default(true)
  termsAcceptedAt     DateTime?
  tenantId            String?
  tenant              Tenant?           @relation(fields: [tenantId], references: [id])
  roleId              String
  role                Role              @relation(fields: [roleId], references: [id])
  registeredWhitelist FacultyWhitelist?
  projectsOwned       Project[]
  projectMemberships  ProjectMember[]
  adviserLinks        ProjectAdviser[]  @relation("UserAdviserLinks")
  notifications       Notification[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Project {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  status      ProjectStatus    @default(DRAFT)
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id])
  members     ProjectMember[]
  advisers    ProjectAdviser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProjectMember {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionLevel String   @default("VIEWER") // VIEWER, EDITOR, FACULTY_REVIEWER
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, userId])
}

model FacultyWhitelist {
  id               String          @id @default(uuid())
  allowedEmail     String          @unique
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  status           WhitelistStatus @default(PENDING_REGISTRATION)
  addedByAdminId   String
  registeredUserId String?         @unique
  registeredUser   User?           @relation(fields: [registeredUserId], references: [id])
  dateAdded        DateTime        @default(now())
  revokedAt        DateTime?
}

model ProjectAdviser {
  id                String            @id @default(uuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adviserUserId     String
  adviserUser       User              @relation("UserAdviserLinks", fields: [adviserUserId], references: [id], onDelete: Cascade)
  status            AdviserLinkStatus @default(PENDING)
  initiatedBy       AdviserInitiator
  requestedByUserId String
  reason            String?
  createdAt         DateTime          @default(now())
  respondedAt       DateTime?
  expiresAt         DateTime?
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  actorId   String?
  actorRole String?
  tenantId  String?
  action    String
  resource  String?
  before    Json?
  after     Json?
  ip        String?
}
